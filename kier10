public class kier10
{
    public static void main(String[] args) {
        int[] arr = {5, 9, 7, 4, 8};

        for (int i = 0; i < arr.length; i++) {
            if (arr[i] % 2 == 0) {
                System.out.println("\nFirst even at index: " + i);
                return;
            }
        }
    }
}
